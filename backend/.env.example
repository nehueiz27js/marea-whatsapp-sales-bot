PORT=4000

# Protege el panel (el frontend la envía desde el servidor). Dejala vacía en desarrollo.
ADMIN_API_KEY=

# WhatsApp Cloud API (Meta). Si las dejás vacías, el bot corre en modo demo (solo simulador).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=elegi-un-texto-secreto
WHATSAPP_APP_SECRET=

# Opcional: transcripción de audios con Whisper
OPENAI_API_KEY=

# Link de cobro que el bot envía al confirmar (Mercado Pago, Stripe, etc.)
PAYMENT_URL=

# Archivo donde se guardan conversaciones y reservas
DATA_FILE=./data/db.json
